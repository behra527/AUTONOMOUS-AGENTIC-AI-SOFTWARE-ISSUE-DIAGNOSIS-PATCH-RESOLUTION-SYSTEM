# Copy to .env. Never commit API keys. Defaults are local development only.
DATABASE_URL=sqlite:///./data/app.db
AUTH_MODE=demo
MODEL_MODE=demo
DATA_DIR=data
LOCAL_REPO_ROOT=data/fixtures
GIT_ALLOWED_HOSTS=github.com,gitlab.com

# Production identity: provision memberships by verified subject, then use oidc.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/
OIDC_SCOPE=openid profile email

# OpenAI-compatible HTTPS endpoint ending in /v1, without trailing route.
# Live mode transmits retrieved source and ticket data to your selected provider.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
